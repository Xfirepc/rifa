# Producción: la aplicación escucha en el host, detrás de tu propio proxy reverso.
COMPOSE_FILE=compose.prod.yaml
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=3008

# Estas variables solo se usan con el compose.yaml opcional que incluye Caddy.
# compose.prod.yaml no publica los puertos 80/443 ni configura el dominio.
HTTPS_PORT=443
SITE_ADDRESS=:80

# Contraseña larga y aleatoria para PostgreSQL.
POSTGRES_PASSWORD=

# Exactamente seis dígitos, diferentes entre sí. Se permiten ceros iniciales.
ADMIN_PIN=
SELLER_PIN=

# Copia automática opcional: al activarla, define también COMPOSE_PROFILES=sheets.
GOOGLE_SHEETS_ENABLED=false
COMPOSE_PROFILES=
GOOGLE_SHEETS_ID=
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# En local sigue HTTP_PORT. En producción escribe la URL HTTPS de tu dominio.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:${HTTP_PORT}/api/admin/sheets/oauth/callback
# Genera una clave de 32 bytes (64 caracteres hexadecimales). Conserva su respaldo.
GOOGLE_TOKEN_KEY=
